print "While Test";
var i = 0;

while (true) {
    print i;
    i = i + 1;

    if (i == 3) {
        break;
    }
}

print "For Test";
for (var i = 0; i < 5; i = i + 1) {
    print i;

    if (i == 4) {
        break;
    }
}


print "Nested Test";
var i = 0;

while (i < 2) {
    var j = 0;

    while (j < 2) {
        print j;
        break;
    }

    i = i + 1;
}
