fun Vector(x, y) {
  fun vector(method) {
    if (method == "x") return x;
    if (method == "y") return y;
  }

  return vector;
}

fun getX(vector) {
  return vector("x");
}

fun getY(vector) {
  return vector("y");
}

fun add(a, b) {
  return Vector(
    getX(a) + getX(b),
    getY(a) + getY(b)
  );
}

var v1 = Vector(2, 3);
var v2 = Vector(4, 5);

var v3 = add(v1, v2);

print getX(v1);
print getY(v1);

print getX(v2);
print getY(v2);

print getX(v3);
print getY(v3);